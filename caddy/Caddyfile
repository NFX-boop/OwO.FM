# /etc/caddy/Caddyfile — OwO.FM (owofm.space)
# Naive: uncomment `order forward_proxy before file_server` + the
# forward_proxy block below ONLY on a Caddy build with klzgrad/forwardproxy
# (install.sh builds this when you opt into NaiveProxy — see install_stack.md).

{
	email admin@owofm.space
	# order forward_proxy before file_server
}

owofm.space {
	encode gzip zstd

	# --- NaiveProxy (custom Caddy build only) ---
	# forward_proxy {
	# 	basic_auth user1 changeme1
	# 	basic_auth user2 changeme2
	# 	hide_ip
	# 	hide_via
	# 	probe_resistance
	# }

	# Streams: MPD httpd output (variant A — no Icecast, see install_stack.md)
	handle /stream/owo {
		uri strip_prefix /stream/owo
		reverse_proxy 127.0.0.1:8001
	}
	handle /stream/owo/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle /stream/citypop {
		uri strip_prefix /stream/citypop
		reverse_proxy 127.0.0.1:8002
	}
	handle /stream/citypop/* {
		reverse_proxy 127.0.0.1:8002
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/owo
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
