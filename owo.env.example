# Copy to /etc/owo/owo.env on the server (chmod 600, root-only).
# install.sh generates this file for you with a random ADMIN_TOKEN — this
# example only exists so the shape is documented in git. Never commit the
# real file, never put ADMIN_TOKEN in web/js.

SITE_URL=https://owofm.space
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_VALUE
API_PORT=8787
SKIP_AUTH=token
BOT_TOKEN=
ADMIN_IDS=123456789,987654321
MPD_OWO_HOST=127.0.0.1
MPD_OWO_PORT=6600
MPD_CITY_HOST=127.0.0.1
MPD_CITY_PORT=6601
MUSIC_ROOT=/var/lib/mpd/music
WWW_ROOT=/var/www/owo
STREAM_OWO=https://owofm.space/stream/owo
STREAM_CITY=https://owofm.space/stream/citypop
